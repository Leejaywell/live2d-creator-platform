{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/sanitize-standalone-output.mjs",
    "start": "node scripts/start-standalone.mjs",
    "docker:build": "node scripts/docker-build.mjs",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "journey:check": "tsx scripts/creator-journey-check.ts",
    "readiness": "tsx scripts/readiness.ts",
    "readiness:full": "tsx scripts/readiness.ts --full",
    "browser:install": "playwright install chromium",
    "browser:qa": "tsx scripts/browser-qa.ts --app-env-file .env.qa",
    "browser:qa:host": "sh scripts/browser-qa-host.sh",
    "qa:provision": "tsx scripts/provision-qa.ts",
    "qa:env:write": "tsx scripts/write-browser-qa-env.ts",
    "post-deploy:verify": "tsx scripts/post-deploy-verify.ts",
    "env:validate:production": "tsx scripts/validate-production-env.ts",
    "ci:verify": "tsx scripts/verify-ci-workflow.ts",
    "monitoring:verify": "tsx scripts/verify-monitoring.ts",
    "monitoring:evidence:collect": "tsx scripts/collect-monitoring-evidence.ts",
    "monitoring:evidence:verify": "tsx scripts/verify-monitoring-evidence.ts",
    "integration:up": "sh scripts/integration-up.sh",
    "integration:down": "docker compose -f docker-compose.integration.yml down",
    "integration:db:migrate": "sh -c 'set -a; . ./.env.integration; set +a; prisma migrate deploy'",
    "integration:readiness": "tsx scripts/readiness.ts --app-env-file .env.integration --full",
    "integration:e2e": "tsx scripts/integration-e2e.ts --app-env-file .env.integration",
    "integration:ci": "sh scripts/integration-readiness.sh",
    "integration:host": "sh scripts/integration-host.sh",
    "release:verify": "tsx scripts/release-verify.ts",
    "release:verify:full": "tsx scripts/release-verify.ts --full",
    "release:verify:host": "npm run release:verify && npm run integration:host",
    "release:audit": "tsx scripts/final-release-audit.ts --output artifacts/release-audit-local.json",
    "release:audit:host": "tsx scripts/final-release-audit.ts --host --browser-host --output artifacts/release-audit-host.json",
    "release:audit:production": "tsx scripts/final-release-audit.ts --production --browser --require-production --output artifacts/release-audit-production.json",
    "release:manifest:write": "tsx scripts/write-release-manifest.ts",
    "release:evidence:verify": "tsx scripts/verify-release-evidence.ts",
    "db:generate": "prisma generate",
    "db:backup": "sh scripts/db-backup.sh",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:production": "sh scripts/production-migrate.sh",
    "db:dev": "prisma migrate dev",
    "demo:models": "tsx scripts/seed-demo-models.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.15"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.60.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
